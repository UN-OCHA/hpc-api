{
  "name": "hpc-api",
  "version": "4.10.1",
  "description": "api for HPC applications",
  "main": "src/server.ts",
  "license": "MIT",
  "private": false,
  "scripts": {
    "check-types": "tsc --noEmit",
    "install-and-link": "sh ./bin/install.sh",
    "reinstall": "rm -rf node_modules/ && yarn install-and-link dev",
    "start": "pm2 start start.js --no-daemon",
    "dev": "ts-node-dev --inspect=127.0.0.1:9339 --transpile-only --no-notify -- start.js",
    "prepare": "[ -d .git ] && git config blame.ignoreRevsFile .git-blame-ignore-revs; husky",
    "lint-prettier": "prettier -c .",
    "lint-eslint": "eslint --quiet .",
    "lint": "yarn lint-prettier && yarn lint-eslint"
  },
  "dependencies": {
    "@unocha/hpc-api-core": "^14.4.0",
    "apollo-server-hapi": "^3.13.0",
    "bunyan": "^1.8.15",
    "class-validator": "^0.14.2",
    "graphql": "^15.10.1",
    "knex": "3.1.0",
    "pg": "^8.16.3",
    "pm2": "^6.0.8",
    "reflect-metadata": "^0.2.2",
    "ts-node": "^10.9.2",
    "type-graphql": "^1.1.1",
    "typedi": "^0.10.0",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@hapi/hapi": "^20.3.0",
    "@types/bunyan": "^1.8.11",
    "@types/hapi__hapi": "^20.0.9",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.1.0",
    "@types/pg": "^8.15.5",
    "@unocha/hpc-repo-tools": "^7.1.1",
    "eslint": "9.32.0",
    "husky": "^9.1.7",
    "jest": "^30.0.5",
    "lint-staged": "^16.1.2",
    "prettier": "3.6.2",
    "ts-jest": "^29.4.0",
    "ts-node-dev": "^2.0.0"
  },
  "engines": {
    "node": ">=20.19.0 || >=22.14.0",
    "yarn": ">=1.22.22"
  },
  "lint-staged": {
    "*.{ts,js,cjs,mjs}": "eslint",
    "*.{js,cjs,mjs,ts,md,json,sh,yml,yaml}": "prettier --check"
  }
}
